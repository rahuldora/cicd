pipeline {
    agent any

    environment {
        SOURCE_BRANCH = "origin/main"
        API_VERSION = "61.0"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Fetch Branches') {
            steps {
                sh '''
                    git fetch --all
                '''
            }
        }

        stage('Generate package.xml') {
            steps {
                script {

                    def changedFiles = sh(
                        script: """
                            git diff --name-only ${SOURCE_BRANCH} HEAD
                        """,
                        returnStdout: true
                    ).trim().split("\\n")

                    echo "Changed Files: ${changedFiles}"

                    def metadataMap = [:]

                    changedFiles.each { file ->

                        if (file.contains("force-app/main/default/classes/")) {

                            def className = file.tokenize('/')[-1].replace('.cls', '')

                            metadataMap.computeIfAbsent('ApexClass') { [] }
                            metadataMap['ApexClass'] << className
                        }

                        else if (file.contains("force-app/main/default/triggers/")) {

                            def triggerName = file.tokenize('/')[-1].replace('.trigger', '')

                            metadataMap.computeIfAbsent('ApexTrigger') { [] }
                            metadataMap['ApexTrigger'] << triggerName
                        }

                        else if (file.contains("force-app/main/default/objects/")) {

                            def parts = file.tokenize('/')

                            def objectIndex = parts.indexOf('objects')

                            if (objectIndex >= 0 && parts.size() > objectIndex + 1) {

                                def objectName = parts[objectIndex + 1]

                                metadataMap.computeIfAbsent('CustomObject') { [] }
                                metadataMap['CustomObject'] << objectName
                            }
                        }

                        else if (file.contains("force-app/main/default/lwc/")) {

                            def parts = file.tokenize('/')

                            def lwcIndex = parts.indexOf('lwc')

                            def lwcName = parts[lwcIndex + 1]

                            metadataMap.computeIfAbsent('LightningComponentBundle') { [] }
                            metadataMap['LightningComponentBundle'] << lwcName
                        }
                    }

                    metadataMap.each { key, value ->
                        metadataMap[key] = value.unique()
                    }

                    def packageXml = new StringBuilder()

                    packageXml.append("""<?xml version="1.0" encoding="UTF-8"?>
                                            <Package xmlns="http://soap.sforce.com/2006/04/metadata">
                    """)

                    metadataMap.each { type, members ->

                        packageXml.append("    <types>\n")

                        members.each { member ->
                            packageXml.append("        <members>${member}</members>\n")
                        }

                        packageXml.append("        <name>${type}</name>\n")
                        packageXml.append("    </types>\n")
                    }

                    packageXml.append("    <version>${API_VERSION}</version>\n")
                    packageXml.append("</Package>")

                    writeFile file: 'manifest/package.xml', text: packageXml.toString()

                    echo packageXml.toString()
                }
            }
        }

        stage('Validate Deployment') {
            steps {
                sh '''
                    cat manifest/package.xml
                    #sf project deploy validate  --manifest manifest/package.xml --target-org DevHub
                '''
            }
        }
    }
}